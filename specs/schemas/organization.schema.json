{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-dos.dev/schemas/organization.schema.json",
  "title": "Organization",
  "type": "object",
  "required": ["id", "name", "billing_email", "tier", "created_at"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "billing_email": { "type": "string", "format": "email" },
    "tier": { "type": "string", "enum": ["standard", "enterprise"] },
    "default_region_id": { "type": ["string", "null"], "format": "uuid", "default": null },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "deleted_at": { "type": ["string", "null"], "format": "date-time", "default": null }
  }
}
