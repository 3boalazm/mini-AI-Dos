# Copy this file to .env and fill in real values for local development.
# .env is gitignored — never commit it. Every value below is either a
# safe local default or an obvious placeholder, never a real secret.

# --- Shared / all services ---
NODE_ENV=development
LOG_LEVEL=debug

# --- Database (TDS §1: PostgreSQL 16+) ---
# Consumed by services/foundation/config once epic 2 (Database Layer)
# adds a Postgres-specific config struct on top of this package.
DATABASE_URL=postgres://ai_dos:ai_dos_local@localhost:5432/ai_dos?sslmode=disable

# --- Cache (TDS §1: Redis Cluster; single node for local dev) ---
REDIS_URL=redis://localhost:6379

# --- Event bus (TDS §1: NATS JetStream) ---
NATS_URL=nats://localhost:4222

# --- Secrets (turn 3/4: secret_ref is a pointer; env vars ARE the
# SecretResolver backend for local dev, OpenBao is the production one) ---
# Real provider credentials are never committed. When epic 6 (OpenAI
# Adapter) lands, it reads its key from a variable named here, not a
# hardcoded string.
OPENAI_API_KEY=

# --- Gateway (added when epic 7 exists; documented now so the shape
# of what will be needed is visible from day one) ---
GATEWAY_PORT=8080
