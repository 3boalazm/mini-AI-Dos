{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-dos.dev/schemas/project.schema.json",
  "title": "Project",
  "type": "object",
  "required": ["id", "organization_id", "name", "created_at"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "organization_id": { "type": "string", "format": "uuid" },
    "team_id": { "type": ["string", "null"], "format": "uuid", "default": null },
    "name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "default_routing_policy_id": { "type": ["string", "null"], "format": "uuid", "default": null },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "deleted_at": { "type": ["string", "null"], "format": "date-time", "default": null }
  }
}
