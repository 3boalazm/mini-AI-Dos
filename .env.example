# Copy to .env and fill in values. .env is gitignored — never commit
# it. Every variable listed here is actually read by the gateway
# (services/gateway/internal/config); there is no other configuration.

# --- Authentication ---
# "env" (default): callers authenticate against MINI_AI_DOS_API_KEY —
#   zero-database development mode.
# "database": callers authenticate against hashed keys in PostgreSQL
#   (created with: go run ./services/gateway/cmd/keygen). Requires
#   DATABASE_URL; the gateway fails fast at startup if the database is
#   unreachable or unmigrated. There is no fallback between modes.
API_KEY_AUTH_MODE=env

# The API key callers must present as "Authorization: Bearer <key>".
# Required in env mode, ignored in database mode. Generate something
# long and random; this example value is not usable.
MINI_AI_DOS_API_KEY=change-me-to-a-long-random-value

# --- Provider selection ---
# "mock" (default) needs no credentials and echoes requests — the
# gateway is fully runnable with it. "openai" speaks the OpenAI-
# compatible wire protocol against AI_BASE_URL.
AI_PROVIDER=mock

# Required only when AI_PROVIDER=openai.
AI_API_KEY=
# Upstream API root. Any OpenAI-compatible endpoint works.
AI_BASE_URL=https://api.openai.com/v1
# Default model when a request omits "model". Optional — with no
# default, every request must name a model.
AI_MODEL=
# Upstream completion timeout in seconds (1-600, default 120). Long
# generations — a full HTML page from a thinking model — routinely
# pass 60s; raise this if callers see "upstream provider timed out".
AI_TIMEOUT=120
# Where the agent loop (POST /v1/agent/runs) writes per-run file
# workspaces. Optional — defaults to a temp directory. Agent runs also
# require AI_MODEL to be set.
AGENT_WORKSPACE_DIR=

# --- Server ---
GATEWAY_PORT=8080
# "development" logs human-readable text; anything else logs JSON.
APP_ENV=development
# debug | info | warn | error
LOG_LEVEL=info

# --- Rate limiting (in-process, fixed window) ---
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=60
# Window length in seconds.
RATE_LIMIT_WINDOW=60

# --- Database ---
# Required when API_KEY_AUTH_MODE=database. Also used by:
#   go run ./services/gateway/cmd/migrate   (apply migrations)
#   go run ./services/gateway/cmd/keygen    (create/list/revoke keys)
# The credentials below match docker-compose.yml — development only,
# never production values.
# DATABASE_URL=postgres://mini_ai_dos:mini_ai_dos_local@localhost:5432/mini_ai_dos?sslmode=disable
