{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-dos.dev/schemas/universal-provider.schema.json",
  "title": "UniversalProviderSchema",
  "type": "object",
  "required": ["id", "display_name", "tier", "status", "deployment_type", "auth", "adapter_ref", "schema_version", "sources"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
    "display_name": { "type": "string", "minLength": 1 },
    "tier": { "type": "string", "enum": ["intelligence", "performance", "abstraction", "sovereignty"] },
    "status": { "type": "string", "enum": ["active", "beta", "deprecated", "disabled"] },
    "status_reason": { "type": ["string", "null"], "default": null },
    "status_changed_at": { "type": ["string", "null"], "format": "date-time", "default": null },
    "deployment_type": { "type": "string", "enum": ["hosted_api", "self_hosted", "edge", "desktop_app"] },
    "website": { "type": ["string", "null"], "format": "uri", "default": null },
    "description": { "type": ["string", "null"], "default": null },
    "adapter_ref": { "type": "string", "minLength": 1 },
    "priority_weight": { "type": "number", "exclusiveMinimum": 0, "default": 1.0 },
    "schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "sources": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "notes": { "type": ["string", "null"], "default": null },
    "auth": {
      "type": "object", "required": ["scheme"],
      "properties": {
        "scheme": { "type": "string", "enum": ["api_key", "oauth2", "mtls", "none", "custom"] },
        "header_name": { "type": ["string", "null"] }, "header_format": { "type": ["string", "null"] },
        "secret_ref": { "type": ["string", "null"] }, "oauth_config": { "type": ["object", "null"] },
        "supports_multiple_keys": { "type": "boolean", "default": false }
      },
      "allOf": [
        { "if": { "properties": { "scheme": { "const": "api_key" } } }, "then": { "required": ["secret_ref"] } },
        { "if": { "properties": { "scheme": { "const": "oauth2" } } }, "then": { "required": ["oauth_config"] } },
        { "if": { "properties": { "scheme": { "const": "none" } } }, "then": { "properties": { "secret_ref": { "const": null }, "oauth_config": { "const": null } } } }
      ]
    },
    "endpoints": { "type": "array", "default": [], "items": { "type": "object", "required": ["id", "type", "url"], "properties": {
      "id": { "type": "string" }, "type": { "type": "string", "enum": ["chat_completions", "completions", "embeddings", "rerank", "image_generation", "realtime_stream", "health"] },
      "url": { "type": "string", "format": "uri-template" }, "protocol": { "type": "string", "enum": ["https", "grpc", "websocket"], "default": "https" },
      "region": { "type": ["string", "null"], "default": null }, "is_default": { "type": "boolean", "default": false } } } },
    "sdk_support": { "type": "array", "default": [], "items": { "type": "object", "required": ["language", "package_name"], "properties": {
      "language": { "type": "string" }, "package_name": { "type": "string" }, "min_version": { "type": ["string", "null"] }, "official": { "type": "boolean", "default": true } } } },
    "capability_summary": { "type": ["object", "null"], "default": null, "properties": {
      "tool_calling": { "type": "string", "enum": ["none", "emulated", "native"] }, "mcp_support": { "type": "string", "enum": ["none", "partial", "native"] },
      "vision": { "type": "boolean" }, "reasoning": { "type": "boolean" }, "embeddings": { "type": "boolean" }, "rerank": { "type": "boolean" },
      "image_gen": { "type": "boolean" }, "structured_output": { "type": "boolean" }, "streaming": { "type": "boolean" },
      "computer_use": { "type": "string", "enum": ["none", "beta", "native"] }, "max_context_window_tokens": { "type": "integer", "exclusiveMinimum": 0 } } },
    "pricing_metadata": { "type": ["object", "null"], "default": null, "properties": {
      "billing_model": { "type": "string", "enum": ["pay_as_you_go", "subscription", "self_hosted_no_billing", "committed_spend"] },
      "currency_default": { "type": "string", "default": "USD" }, "has_free_tier": { "type": "boolean" },
      "free_tier_notes": { "type": ["string", "null"] }, "billing_granularity": { "type": "string", "enum": ["per_token", "per_request", "per_second", "flat_rate"] } } },
    "rate_limit_policy": { "type": ["object", "null"], "default": null, "properties": {
      "requests_per_minute": { "type": ["integer", "null"], "minimum": 0 }, "tokens_per_day": { "type": ["integer", "null"], "minimum": 0 },
      "concurrent_requests": { "type": ["integer", "null"], "minimum": 0 }, "notes": { "type": ["string", "null"] } } },
    "compliance_tags": { "type": "array", "items": { "type": "string" }, "default": [] },
    "regions": { "type": "array", "items": { "type": "string" }, "default": [] },
    "current_health": { "type": ["object", "null"], "default": null, "properties": {
      "status": { "type": "string", "enum": ["healthy", "degraded", "down", "unknown"] }, "last_checked_at": { "type": ["string", "null"], "format": "date-time" },
      "latency_p50_ms": { "type": ["number", "null"], "minimum": 0 }, "latency_p95_ms": { "type": ["number", "null"], "minimum": 0 },
      "error_rate_24h": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }, "circuit_state": { "type": "string", "enum": ["closed", "open", "half_open"] } } }
  },
  "allOf": [{ "if": { "properties": { "status": { "const": "active" } } }, "then": { "required": ["endpoints"], "properties": { "endpoints": { "type": "array", "minItems": 1 } } } }]
}
