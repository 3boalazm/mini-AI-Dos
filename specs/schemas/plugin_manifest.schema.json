{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-dos.dev/schemas/plugin-manifest.schema.json",
  "title": "PluginManifest",
  "type": "object",
  "required": ["plugin_id", "display_name", "version", "provides", "trust_level", "sources"],
  "additionalProperties": false,
  "properties": {
    "plugin_id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
    "display_name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "provides": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["extension_point", "entry_point_ref"], "additionalProperties": false, "properties": {
      "extension_point": { "type": "string" },
      "entry_point_ref": { "type": "string", "pattern": "^[a-zA-Z_][a-zA-Z0-9_.]*:[a-zA-Z_][a-zA-Z0-9_]*$" } } } },
    "config_schema_ref": { "type": ["string", "null"], "default": null },
    "min_platform_version": { "type": ["string", "null"], "pattern": "^\\d+\\.\\d+\\.\\d+$|^$", "default": null },
    "trust_level": { "type": "string", "enum": ["first_party", "verified_third_party", "unverified"] },
    "author": { "type": ["string", "null"], "default": null },
    "sources": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
  }
}
